<Project>
    <PropertyGroup>
        <Version>0.0.0.0</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <FileVersion>0.0.0.0</FileVersion>

        <!--
            Jellyfin version the plugin is compiled against. One source tree produces one build per
            Jellyfin generation (10.8, 10.10, 10.11, 12.x): plugins are not binary compatible across them.
            Override with: dotnet build -p:JellyfinVersion=10.10.7
        -->
        <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>

        <!-- Keep the builds of different Jellyfin versions apart so they never overwrite each other. -->
        <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\jf$(JellyfinVersion)\</BaseIntermediateOutputPath>
        <BaseOutputPath>$(MSBuildProjectDirectory)\bin\jf$(JellyfinVersion)\</BaseOutputPath>
    </PropertyGroup>
</Project>
